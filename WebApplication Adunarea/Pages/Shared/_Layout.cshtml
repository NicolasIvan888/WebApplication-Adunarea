<!DOCTYPE html>
<html lang="ro">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Joc simplu pentru exersarea adunării rapide și a memoriei vizuale." />
    <title>@ViewData["Title"] | Adunarea rapidă</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="site-header">
        <a class="brand" asp-page="/Index" aria-label="Pagina principală"><span class="brand-mark">+</span><span>Adunarea rapidă</span></a>
    </header>
    <main class="page-shell" role="main">@RenderBody()</main>
    <footer class="site-footer">
        <span>&copy; @DateTime.Now.Year Ivanov Nicolae</span>
        <span>Proiect educațional realizat cu ASP.NET Core</span>
    </footer>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
