@page
@model WebApplication_Adunarea.Pages.IndexModel
@{
    ViewData["Title"] = "Adunarea rapidă";
}

<section class="game-card" aria-labelledby="game-title">
    <div class="game-intro">
        <span class="eyebrow">Antrenament mental</span>
        <h1 id="game-title">Adunarea rapidă</h1>
        <p>Memorează numerele afișate pe rând, calculează suma în minte și verifică rezultatul la final.</p>
    </div>

    <div class="game-settings" id="game-settings">
        <label>Numere
            <select id="number-count" class="form-select">
                <option value="5">5</option>
                <option value="10" selected>10</option>
                <option value="15">15</option>
            </select>
        </label>
        <label>Viteză
            <select id="display-speed" class="form-select">
                <option value="1200">Relaxat</option>
                <option value="900" selected>Normal</option>
                <option value="600">Rapid</option>
            </select>
        </label>
        <button id="start-button" class="btn btn-primary btn-lg" type="button">Începe exercițiul</button>
    </div>

    <div class="game-stage" aria-live="polite" aria-atomic="true">
        <div class="progress-track" aria-hidden="true"><span id="progress-bar"></span></div>
        <span id="round-progress" class="round-progress">Pregătit</span>
        <strong id="number-display" class="number-display">+</strong>
        <p id="status-message">Alege dificultatea și apasă „Începe exercițiul”.</p>
    </div>

    <div id="result-panel" class="result-panel" hidden>
        <button id="reveal-button" class="btn btn-primary" type="button">Arată rezultatul</button>
        <div id="result-content" hidden>
            <span class="result-label">Suma corectă</span>
            <strong id="total-result" class="total-result"></strong>
            <p id="sequence-result" class="sequence-result"></p>
        </div>
        <button id="restart-button" class="btn btn-outline-light" type="button" hidden>Exercițiu nou</button>
        <p class="keyboard-hint">Poți folosi și tasta <kbd>Space</kbd>.</p>
    </div>
</section>
